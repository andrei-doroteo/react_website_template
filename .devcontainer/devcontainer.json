    "forwardPorts": [
        5900,
        6080
    ],
    "portsAttributes": {
        "5900": {
            "label": "VNC Server",
            "onAutoForward": "silent"
        },
        "6080": {
            "label": "noVNC (Browser Access)",
            "onAutoForward": "notify"
        }
    },
    // "postStartCommand": "echo '\n🎮 Virtual Desktop Ready!\n\nAccess the desktop at: http://localhost:6080/vnc.html\nTo run the frog game: python src/main.py\nControls: e=forward, d=backward, s=left, f=right\n'",
    "remoteUser": "dev"
}